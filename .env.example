# "local-dev" (default) allows credential fallbacks and optional auth.
# Any other value makes INTERNAL_API_TOKEN, DATABASE_URL, NEO4J_PASSWORD and
# GATEWAY_API_KEY mandatory (services fail closed at startup).
APP_ENV=local-dev
# API key required (X-Api-Key header) on every gateway route outside local-dev.
GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
# Shared secret checked on every api -> engine request. Required outside local dev.
INTERNAL_API_TOKEN=
# Real ingestion connector (NewsApiConnector) is used when this is set; falls
# back to mock fixtures otherwise. Get a key at https://newsapi.org
NEWSAPI_KEY=

# Social media ingestion via SocialCrawl MCP server
SOCIALCRAWL_API_KEY=
